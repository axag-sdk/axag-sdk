{
  "name": "@axag/schema-openapi",
  "version": "0.1.0",
  "description": "Use OpenAPI operations as the parameter source for AXAG actions",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "engines": { "node": ">=18.0.0" },
  "license": "MIT",
  "keywords": ["axag", "openapi", "json-schema", "mcp"],
  "dependencies": {
    "@axag/core": "workspace:*",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
}
