{
  "name": "@axag/shim",
  "version": "0.1.0",
  "description": "A WebMCP registry for browsers that don't have one yet, so AXAG code runs unchanged",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/axag-sdk/axag-sdk.git",
    "directory": "packages/shim"
  },
  "homepage": "https://axag.org",
  "bugs": {
    "url": "https://github.com/axag-sdk/axag-sdk/issues"
  },
  "keywords": [
    "axag",
    "webmcp",
    "polyfill",
    "shim",
    "modelcontext"
  ],
  "devDependencies": {
    "@axag/webmcp": "workspace:*",
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.0",
    "happy-dom": "^20.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
}
