{
  "name": "@axag/vue",
  "version": "0.1.0",
  "description": "Vue bindings for AXAG: register agent actions for as long as the component is mounted",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/web-axag/axag-sdk.git",
    "directory": "packages/vue"
  },
  "homepage": "https://axag.org",
  "bugs": {
    "url": "https://github.com/web-axag/axag-sdk/issues"
  },
  "keywords": [
    "axag",
    "vue",
    "webmcp",
    "mcp",
    "agent"
  ],
  "dependencies": {
    "@axag/core": "workspace:*",
    "@axag/webmcp": "workspace:*"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "happy-dom": "^20.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0",
    "vue": "^3.5.42"
  }
}
