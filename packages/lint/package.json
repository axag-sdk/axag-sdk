{
  "name": "@web-axag/lint",
  "version": "1.1.0",
  "description": "Static linter for AXAG annotations in HTML, JSX, and TSX files",
  "type": "module",
  "bin": {
    "axag-lint": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/axag-sdk/axag-sdk.git",
    "directory": "packages/lint"
  },
  "keywords": [
    "axag",
    "linter",
    "annotations",
    "agent-experience",
    "semantic-contract",
    "validation"
  ],
  "dependencies": {
    "@web-axag/core": "workspace:*",
    "@babel/parser": "^7.29.2",
    "@babel/traverse": "^7.29.0",
    "ajv": "^8.18.0",
    "ajv-formats": "^3.0.1",
    "chalk": "^5.6.2",
    "cheerio": "^1.2.0",
    "commander": "^14.0.3",
    "fast-glob": "^3.3.3"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  },
  "homepage": "https://axag.org",
  "bugs": {
    "url": "https://github.com/axag-sdk/axag-sdk/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ]
}
